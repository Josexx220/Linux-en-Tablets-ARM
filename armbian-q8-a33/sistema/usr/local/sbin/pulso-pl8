#!/usr/bin/env python3
import mmap
import os
import struct
import time

DIRECCION = 0x01F02C10
DIRECCION_CFG0 = 0x01F02C00
BIT_PL4 = 1 << 4
BIT_PL6 = 1 << 6
BIT_PL8 = 1 << 8

pagina = mmap.PAGESIZE
base = DIRECCION & ~(pagina - 1)
offset = DIRECCION - base
offset_cfg0 = DIRECCION_CFG0 - base

fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
try:
    memoria = mmap.mmap(
        fd,
        pagina,
        flags=mmap.MAP_SHARED,
        prot=mmap.PROT_READ | mmap.PROT_WRITE,
        offset=base,
    )
    try:
        def leer():
            return struct.unpack_from("<I", memoria, offset)[0]

        def escribir(valor):
            struct.pack_into("<I", memoria, offset, valor)

        cfg0 = struct.unpack_from("<I", memoria, offset_cfg0)[0]
        cfg0 = (cfg0 & ~(0xF << 16)) | (1 << 16)
        struct.pack_into("<I", memoria, offset_cfg0, cfg0)

        escribir(leer() | BIT_PL4)
        print(f"PL4 alto; PL_CFG0: 0x{cfg0:08x}, PL_DATA: 0x{leer():08x}")

        inicial = leer()
        print(f"PL_DATA inicial: 0x{inicial:08x}")

        escribir(inicial & ~(BIT_PL6 | BIT_PL8))
        print(f"PL6 y PL8 bajos: 0x{leer():08x}")

        time.sleep(0.100)

        escribir(leer() | BIT_PL6)
        print(f"PL6 alto, PL8 bajo: 0x{leer():08x}")

        time.sleep(0.114)

        escribir(leer() | BIT_PL8)
        print(f"PL6 y PL8 altos: 0x{leer():08x}")

        time.sleep(0.200)
    finally:
        memoria.close()
finally:
    os.close(fd)
