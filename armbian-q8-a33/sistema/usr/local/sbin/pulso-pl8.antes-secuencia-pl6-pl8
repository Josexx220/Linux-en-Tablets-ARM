#!/usr/bin/env python3
import mmap
import os
import struct
import time

DIRECCION = 0x01F02C10
BIT_PL8 = 1 << 8

pagina = mmap.PAGESIZE
base = DIRECCION & ~(pagina - 1)
offset = DIRECCION - base

fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
try:
    memoria = mmap.mmap(
        fd,
        pagina,
        flags=mmap.MAP_SHARED,
        prot=mmap.PROT_READ | mmap.PROT_WRITE,
        offset=base,
    )
    try:
        valor = struct.unpack_from("<I", memoria, offset)[0]
        print(f"PL_DATA inicial: 0x{valor:08x}")

        struct.pack_into("<I", memoria, offset, valor & ~BIT_PL8)
        print("PL8 bajo")
        time.sleep(0.214)

        valor = struct.unpack_from("<I", memoria, offset)[0]
        struct.pack_into("<I", memoria, offset, valor | BIT_PL8)

        final = struct.unpack_from("<I", memoria, offset)[0]
        print(f"PL8 alto; PL_DATA final: 0x{final:08x}")
    finally:
        memoria.close()
finally:
    os.close(fd)
